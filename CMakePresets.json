{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "arm",
            "displayName": "Alchemy Lab V2 (ARM cross-compile)",
            "description": "Firmware build for the production V2 board. The default.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-arm",
            "toolchainFile": "${sourceDir}/cmake/toolchains/stm32h750xx.cmake",
            "cacheVariables": {
                "ALCHEMY_BOARD": "v2"
            }
        },
        {
            "name": "host",
            "displayName": "Host (native, libDaisy stubs)",
            "description": "Native build of the V1 BSP + framework for CI smoke checks.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-host"
        }
    ],
    "buildPresets": [
        {
            "name": "arm",
            "configurePreset": "arm"
        },
        {
            "name": "host",
            "configurePreset": "host"
        }
    ]
}
